// Lab 4 — Maven build with published test reports and archived artifacts.
// dir('p4-java-maven') = run the steps inside that subfolder, because the
// workspace root holds every lab of the repo and pom.xml lives one level down.
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('p4-java-maven') {
                    echo 'Compiling...'
                    sh 'mvn -B -ntp compile'
                }
            }
        }
        stage('Test') {
            steps {
                dir('p4-java-maven') {
                    echo 'Running JUnit tests...'
                    sh 'mvn -B -ntp test'
                }
            }
        }
        stage('Package') {
            steps {
                dir('p4-java-maven') {
                    echo 'Packaging the jar...'
                    sh 'mvn -B -ntp -DskipTests package'
                }
            }
        }
    }

    post {
        always {
            dir('p4-java-maven') {
                // Turns Maven's surefire XML into the Jenkins test trend graphs.
                junit testResults: 'target/surefire-reports/*.xml', allowEmptyResults: false
            }
        }
        success {
            dir('p4-java-maven') {
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
    }
}
